5 REM WAVE ANIMATION BY BRENDAN ROBERT
10 PRINT CHR$(4)"BLOAD WAVE.CODE"
20 FOR F = 0 TO 4: HGR2 :A = F * 1.3:C = 0: FOR Z = 0 TO 10 STEP .2:C = 1 - C: HCOLOR= 7 - 4 * C:J = (Z - 5) * (Z - 5):K = Z * 3 + 20:L = Z * 10 + 50: FOR X = 0 TO 10 STEP .2: HPLOT X * 20 + K,L - 5 * COS(3 * SQR((X - 5) * (X - 5) + J) + A): NEXT X,Z
30 POKE 769,32 * (F + 1): CALL 768: NEXT : CALL 792
40 TEXT : HOME : PRINT CHR$(4)"RUN STARTUP"
