; Appletini SmartPort glyph API 1.0 (ca65). See README_GLYPH_API.md.
.ifndef APPLETINI_GLYPH_API_INC
APPLETINI_GLYPH_API_INC = 1

AGLY_SELECTOR = $81
AGLY_STATUS_SIZE = 32
AGLY_HEADER_SIZE = 16
AGLY_ROM_SIZE = 4096
AGLY_MAX_CHUNK = 512
AGLY_MAJOR = 1

AGLY_BEGIN = 1
AGLY_WRITE = 2
AGLY_COMMIT = 3
AGLY_ABORT = 4
AGLY_RESTORE = 5

AGLY_AVAILABLE = $0001
AGLY_CUSTOM_ACTIVE = $0002
AGLY_PENDING = $0004
AGLY_UPLOADING = $0008

AGLY_UNSUPPORTED = $21
AGLY_UNAVAILABLE = $60
AGLY_BAD_HEADER = $61
AGLY_BAD_COMMAND = $62
AGLY_RANGE = $63
AGLY_TRANSACTION = $64
AGLY_INCOMPLETE = $65
AGLY_BUSY = $66
AGLY_CHECKSUM = $67

; STATUS buffer offsets; all multi-byte integers are little endian.
AGLY_STATUS_FLAGS = 8
AGLY_STATUS_ROM_SIZE = 10
AGLY_STATUS_MAX_CHUNK = 12
AGLY_STATUS_ERROR = 14
AGLY_STATUS_OPERATION = 15
AGLY_STATUS_TRANSACTION = 16
AGLY_STATUS_COVERED = 20
AGLY_STATUS_GENERATION = 24

; CONTROL payload offsets AFTER the two-byte length word.
AGLY_CONTROL_OPERATION = 5
AGLY_CONTROL_TRANSACTION = 8
AGLY_CONTROL_OFFSET = 12
AGLY_CONTROL_COUNT = 14
AGLY_CONTROL_DATA = 16
.endif
